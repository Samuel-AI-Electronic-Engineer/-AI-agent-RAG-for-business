# ─── ENTORNO ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True

# ─── BASE DE DATOS ───────────────────────────────────────────
# En producción usa DATABASE_URL y no definas credenciales por separado.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poetry_fiction_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_local

# ─── SEGURIDAD JWT ───────────────────────────────────────────
SECRET_KEY=genera-una-clave-aleatoria-de-al-menos-32-caracteres
ALGORITHM=HS256
# ─── APLICACIÓN ──────────────────────────────────────────────
APP_NAME=Poesía y Ficción
APP_VERSION=1.0.0
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500
